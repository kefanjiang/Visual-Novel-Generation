# Neon Postgres (added automatically when you connect Neon from the Vercel Marketplace)
DATABASE_URL=

# Model provider: anthropic | openai | google
LLM_PROVIDER=anthropic
# Optional model overrides (defaults depend on provider)
LLM_MODEL_STRONG=
LLM_MODEL_FAST=
# API key for the chosen provider (only the one you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Salt for hashing IPs in rate limiting
IP_SALT=change-me

# Daily limits (optional)
LIMIT_IP_GENERATE=3
LIMIT_IP_EDIT=15
LIMIT_GLOBAL_GENERATE=60
LIMIT_GLOBAL_EDIT=300

# Admin token for marking homepage examples
ADMIN_TOKEN=
